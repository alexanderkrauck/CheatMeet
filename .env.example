# Required server-only secret. AI Studio can inject it via its Secrets panel.
GEMINI_API_KEY=""
ASSEMBLYAI_API_KEY=""

# Optional server settings. Never prefix secrets with VITE_.
# GEMINI_MODEL summarises the finished transcript into the report.
GEMINI_MODEL="gemini-3.6-flash"
# Legacy segment endpoint only. New recordings use AssemblyAI streaming plus
# one final batch pass; Gemini summarizes the final text.
# GEMINI_FAST_MODEL defaults to GEMINI_MODEL when unset.
# GEMINI_FAST_MODEL=""
# Server-held Google Drive authorization. BOTH are required; with either missing
# the app falls back to the browser popup flow, which expires after ~1h.
# Set the client ID explicitly: it otherwise falls back to `oAuthClientId` in
# firebase-applet-config.json, and some deployments ship that file without it.
# Register <origin>/api/auth/google/callback as an authorized redirect URI.
# Check with: curl <origin>/api/auth/config
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

PORT=3000
# FIREBASE_PROJECT_ID defaults to firebase-applet-config.json projectId.
# FIREBASE_PROJECT_ID="gen-lang-client-0187125016"

# Optional public build-time overrides; use the existing Firebase config by default.
# The selected Firestore database must exist and have owner-scoped rules deployed.
# VITE_FIRESTORE_DATABASE_ID="(default)"
# Picker uses firebase config apiKey and messagingSenderId unless overridden.
# Enable the Google Picker API and Google Drive API in that project.
# VITE_GOOGLE_API_KEY=""
# VITE_GOOGLE_PROJECT_NUMBER=""

# Google Calendar (optional, off by default).
#
# Two prerequisites, in this order:
#   1. Enable the Google Calendar API on the project:
#        gcloud services enable calendar-json.googleapis.com --project=<id>
#      Without it every calendar call returns 403 SERVICE_DISABLED, whatever
#      the token says.
#   2. Add https://www.googleapis.com/auth/calendar.events to the OAuth
#      consent screen. This is Console-only — there is no gcloud command and
#      no public API for it. It is a sensitive scope: an app in "Testing" can
#      grant it to its test users with an unverified-app warning; a published
#      app needs it registered and verified or Google refuses it.
#
# Turning this on changes only what the authorization request asks for. If the
# consent screen has not been updated, expect the calendar scope to be refused
# — set this back to false and the Drive flow is byte-identical to before.
#
# Existing users must sign in again either way: a refresh token's scopes are
# fixed when it is issued, so their grant stays Drive-only until they
# re-consent.
GOOGLE_CALENDAR=false
