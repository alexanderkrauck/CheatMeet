rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function projectedReport(reportId) {
      return request.resource.data.id == reportId
        && request.resource.data.title is string
        && request.resource.data.date is string
        && request.resource.data.get('summary', '') is string
        && request.resource.data.get('todos', []) is list
        && request.resource.data.get('takeaways', []) is list
        && request.resource.data.get('transcription', '') == ''
        && !request.resource.data.keys().hasAny(['speech']);
    }
    function optionalReference(home, field) {
      return home.get(field, '') is string && home.get(field, '').size() <= 512;
    }
    function microsoftHome(home) {
      return home is map
        && home.keys().hasOnly(['provider', 'connectionId', 'driveId', 'rootId', 'rootName', 'folderId', 'reportId', 'audioId', 'markdownId', 'transcriptId', 'consentId', 'webUrl', 'syncedAt'])
        && home.provider == 'microsoft'
        && home.connectionId is string && home.connectionId.size() > 0 && home.connectionId.size() <= 512
        && home.driveId is string && home.driveId.size() > 0 && home.driveId.size() <= 512
        && home.rootId is string && home.rootId.size() > 0 && home.rootId.size() <= 512
        && home.rootName is string && home.rootName.size() > 0 && home.rootName.size() <= 500
        && optionalReference(home, 'folderId') && optionalReference(home, 'reportId')
        && optionalReference(home, 'audioId') && optionalReference(home, 'markdownId')
        && optionalReference(home, 'transcriptId') && optionalReference(home, 'consentId')
        && home.get('webUrl', '') is string && home.get('webUrl', '').size() <= 4000
        && home.get('syncedAt', '') is string && home.get('syncedAt', '').size() <= 100;
    }
    match /users/{userId}/reports/{reportId} {
      allow read, delete: if owns(userId);
      // The cloud copy is an index: the transcript lives in the user's Drive
      // and on their devices. The projection still writes an empty
      // `transcription`, so the bound is on content, not on the key.
      // Deliberately not hasOnly(): the index grows with every feature, and a
      // service-worker-cached client still writing yesterday's key set must
      // not be locked out of saving at all.
      allow create, update: if owns(userId)
        && request.resource.data.id == reportId
        && request.resource.data.title is string
        && request.resource.data.date is string
        && request.resource.data.get('summary', '') is string
        && request.resource.data.get('todos', []) is list
        && request.resource.data.get('takeaways', []) is list
        && request.resource.data.get('transcription', '') == ''
        && !request.resource.data.keys().hasAny(['speech', 'home']);
    }
    // Separate namespace prevents cached Google-only clients rerouting OneDrive archives.
    match /users/{userId}/meetings/{reportId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId) && projectedReport(reportId)
        && microsoftHome(request.resource.data.home)
        && !request.resource.data.keys().hasAny(['driveFolderId', 'driveReportId', 'rawAudioUrl']);
    }
    match /users/{userId}/settings/providers {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['calendarProvider', 'calendarConnectionId', 'calendarId', 'meetingHome'])
        && request.resource.data.get('calendarProvider', 'google') in ['google', 'microsoft']
        && optionalReference(request.resource.data, 'calendarConnectionId')
        && optionalReference(request.resource.data, 'calendarId')
        && (request.resource.data.get('meetingHome', null) == null || microsoftHome(request.resource.data.meetingHome));
    }
    match /users/{userId}/settings/preferences {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['summaryPrompt'])
        && request.resource.data.summaryPrompt is string;
    }
    match /users/{userId}/settings/drive {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['folder'])
        && request.resource.data.folder.keys().hasOnly(['id', 'name'])
        && request.resource.data.folder.id is string
        && request.resource.data.folder.name is string;
    }
    // Deny every other collection, including the original unauthenticated layout.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
